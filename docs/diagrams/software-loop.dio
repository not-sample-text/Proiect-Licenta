                <mxCell id="e_s3" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="LOAD_CFG" target="LISTEN_SER" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                
                <mxCell id="e_s4" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="LISTEN_SER" target="PARSE_CMD" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                
                <mxCell id="e_s5" value="Yes (Action mapped)" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="PARSE_CMD" target="EXECUTE" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
