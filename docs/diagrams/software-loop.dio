                </mxCell>
                
                <mxCell id="LOAD_CFG" value="Hunt &amp; Load config.json&lt;br&gt;(Docs, Downloads, Local)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="330" y="240" width="140" height="40" as="geometry"/>
                </mxCell>
                
                <mxCell id="LISTEN_SER" value="Listen for Serial Input" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
