                </mxCell>
                
                <mxCell id="PARSE_CMD" value="Valid Command?&lt;br&gt;(e.g., L3:C0R1)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="340" y="400" width="120" height="80" as="geometry"/>
                </mxCell>
                
                <mxCell id="EXECUTE" value="Route to OS&lt;br&gt;(Launch App / Run Script)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="330" y="520" width="140" height="60" as="geometry"/>
                </mxCell>
                
                <mxCell id="TRAY_UI" value="System Tray UI&lt;br&gt;(Parallel Thread)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="120" y="230" width="120" height="60" as="geometry"/>
                </mxCell>

                <mxCell id="e_s1" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="SW_START" target="PING_PONG" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
