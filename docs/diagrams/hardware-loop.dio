                    <mxGeometry x="350" y="320" width="100" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="HID_OUT" value="Send USB/BLE HID&lt;br&gt;(F-Keys / Shortcuts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="180" y="440" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="SER_OUT" value="Send Serial String&lt;br&gt;(e.g., L2:C1R2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="480" y="440" width="140" height="60" as="geometry"/>
                </mxCell>
