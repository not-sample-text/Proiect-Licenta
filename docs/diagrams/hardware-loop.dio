                    <mxGeometry x="340" y="560" width="120" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="DELAY" value="Debounce / Sleep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="340" y="640" width="120" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="e_h1" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="HW_START" target="SCAN_MAT" edge="1">
